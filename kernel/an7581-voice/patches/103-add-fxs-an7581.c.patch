--- /dev/null
+++ b/fxs_an7581.c
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AN7581 + Le9641 FXS provider for fxs-core.
+ *
+ * The PCM engine and the Le9641 SLIC keep their register-level code; this
+ * file is only the glue that exposes them as one generic FXS line.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/fs.h>
+#include <linux/poll.h>
+
+#include "fxs.h"
+
+/* an7581-pcm.c */
+extern bool an7581_pcm_fxs_ready(void);
+extern int an7581_pcm_fxs_open(struct file *file);
+extern void an7581_pcm_fxs_close(struct file *file);
+extern ssize_t an7581_pcm_fxs_read(struct file *file, char __user *buf,
+				   size_t count, loff_t *ppos);
+extern ssize_t an7581_pcm_fxs_write(struct file *file, const char __user *buf,
+				    size_t count, loff_t *ppos);
+extern __poll_t an7581_pcm_fxs_poll(struct file *file, poll_table *wait);
+
+/* an7581_slic_le9641.c */
+extern bool an7581_slic_fxs_ready(void);
+extern int an7581_slic_fxs_set_ring(bool on);
+extern int an7581_slic_fxs_set_active(bool on);
+extern int an7581_slic_fxs_get_hook(bool *offhook);
+extern int an7581_slic_fxs_set_hook_cb(void (*cb)(void *data, bool offhook),
+				       void *data);
+
+static void an7581_hook_cb(void *data, bool offhook)
+{
+	struct fxs_event event = {
+		.type = FXS_EV_HOOK,
+		.value = offhook,
+	};
+
+	fxs_event_push(data, &event);
+}
+
+static int an7581_slic_init(struct fxs_line *line)
+{
+	if (!an7581_pcm_fxs_ready() || !an7581_slic_fxs_ready())
+		return -ENODEV;
+
+	return an7581_slic_fxs_set_hook_cb(an7581_hook_cb, line);
+}
+
+static void an7581_slic_exit(struct fxs_line *line)
+{
+	an7581_slic_fxs_set_hook_cb(NULL, NULL);
+}
+
+static int an7581_set_ring(struct fxs_line *line, bool on)
+{
+	return an7581_slic_fxs_set_ring(on);
+}
+
+static int an7581_set_active(struct fxs_line *line, bool on)
+{
+	return an7581_slic_fxs_set_active(on);
+}
+
+static int an7581_get_hook(struct fxs_line *line, bool *offhook)
+{
+	return an7581_slic_fxs_get_hook(offhook);
+}
+
+static int an7581_pcm_open(struct fxs_line *line, struct file *file)
+{
+	return an7581_pcm_fxs_open(file);
+}
+
+static void an7581_pcm_close(struct fxs_line *line, struct file *file)
+{
+	an7581_pcm_fxs_close(file);
+}
+
+static ssize_t an7581_pcm_read(struct fxs_line *line, struct file *file,
+			       char __user *buf, size_t count, loff_t *ppos)
+{
+	return an7581_pcm_fxs_read(file, buf, count, ppos);
+}
+
+static ssize_t an7581_pcm_write(struct fxs_line *line, struct file *file,
+				const char __user *buf, size_t count,
+				loff_t *ppos)
+{
+	return an7581_pcm_fxs_write(file, buf, count, ppos);
+}
+
+static __poll_t an7581_pcm_poll(struct fxs_line *line, struct file *file,
+				poll_table *wait)
+{
+	return an7581_pcm_fxs_poll(file, wait);
+}
+
+static const struct fxs_slic_ops an7581_slic_ops = {
+	.caps		= FXS_CAP_RING | FXS_CAP_HOOK,
+	.init		= an7581_slic_init,
+	.exit		= an7581_slic_exit,
+	.set_ring	= an7581_set_ring,
+	.set_active	= an7581_set_active,
+	.get_hook	= an7581_get_hook,
+};
+
+static const struct fxs_pcm_ops an7581_pcm_ops = {
+	.open	= an7581_pcm_open,
+	.close	= an7581_pcm_close,
+	.read	= an7581_pcm_read,
+	.write	= an7581_pcm_write,
+	.poll	= an7581_pcm_poll,
+};
+
+static struct fxs_line *an7581_line;
+
+static int __init fxs_an7581_init(void)
+{
+	an7581_line = fxs_register_line(NULL, "line1", THIS_MODULE,
+					&an7581_slic_ops, NULL,
+					&an7581_pcm_ops, NULL);
+	if (IS_ERR(an7581_line))
+		return PTR_ERR(an7581_line);
+
+	return 0;
+}
+
+static void __exit fxs_an7581_exit(void)
+{
+	fxs_unregister_line(an7581_line);
+	an7581_line = NULL;
+}
+
+module_init(fxs_an7581_init);
+module_exit(fxs_an7581_exit);
+
+MODULE_INFO(author, "ming");
+MODULE_INFO(description, "AN7581 Le9641 FXS line provider");
+MODULE_LICENSE("GPL");
