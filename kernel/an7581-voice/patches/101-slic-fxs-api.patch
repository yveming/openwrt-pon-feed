+static void le9641_exit(struct fxs_line *line)
+{
+	struct an7581_slic *slic = slic_dbg;
+
+	if (!slic)
+		return;
+
+	mutex_lock(&slic->lock);
+	if (slic->hook_data == line) {
+		slic->hook_cb = NULL;
+		slic->hook_data = NULL;
+	}
+	mutex_unlock(&slic->lock);
 }
 
