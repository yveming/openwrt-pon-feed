+resolve_igmp_vid() {
+	case "$IGMP_VID" in
+		''|mcast)
+			IGMP_VID=mcast
+			IGMP_ON_SERVICE=0
+			;;
+		service)
+			IGMP_ON_SERVICE=1
+			;;
+		*)
+			log_fail "invalid igmp_vid '$IGMP_VID' (expected 'mcast' or 'service')"
+			return 1
+			;;
+	esac
+}
+
+write_igmp_on_service() {
+	printf '%s\n' "$IGMP_ON_SERVICE" \
+		> "/sys/class/net/$NAME/igmp_on_service" || {
+		log_fail "cannot write igmp_on_service=$IGMP_ON_SERVICE to $NAME"
+		return 1
+	}
+}
