#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

. /lib/functions.sh

fail() {
	logger -t iptv "$*"
	echo "iptv: $*" >&2
	exit 1
}

validate_ifname() {
	local name="$1"

	[ -n "$name" ] || return 1
	[ "${#name}" -le 15 ] || return 1

	case "$name" in
		*[!A-Za-z0-9_.:-]*) return 1 ;;
	esac

	return 0
}

validate_vid() {
	local vid="$1"

	case "$vid" in
		''|*[!0-9]*) return 1 ;;
	esac

	[ "$vid" -ge 1 ] && [ "$vid" -le 4094 ]
}

load_config() {
	config_load iptv
	config_get_bool ENABLED config enabled 0
	config_get UPLINK config uplink pon0
	config_get NAME config name itv
	config_get SERVICE_VID config service_vid
	config_get MCAST_VID config mcast_vid
	config_get MACADDR config macaddr
}

device_exists() {
	[ -e "/sys/class/net/$NAME" ]
}

lower_matches() {
	[ "$(cat "/sys/class/net/$NAME/iflink" 2>/dev/null)" = \
	  "$(cat "/sys/class/net/$UPLINK/ifindex" 2>/dev/null)" ]
}

destroy_device() {
	device_exists && ip link del "$NAME" 2>/dev/null || true
}

write_vids() {
	printf '%s %s\n' "$SERVICE_VID" "$MCAST_VID" \
		> "/sys/class/net/$NAME/vids" ||
		fail "cannot configure VLANs on $NAME"
}

apply_device() {
	[ -d /sys/module/iptv ] || modprobe iptv 2>/dev/null ||
		fail "cannot load the iptv module"

	if device_exists && lower_matches; then
		write_vids
	else
		destroy_device
		ip link add dev "$NAME" link "$UPLINK" type iptv ||
			fail "cannot create device $NAME on $UPLINK"
		write_vids
	fi

	if [ -n "$MACADDR" ]; then
		ip link set "$NAME" address "$MACADDR" ||
			fail "cannot set MAC address on $NAME"
	fi

	ip link set "$NAME" up || fail "cannot bring up $NAME"
}

apply() {
	load_config

	if [ "$ENABLED" -ne 1 ]; then
		destroy_device
		return 0
	fi

	validate_ifname "$UPLINK" || fail "invalid uplink device name"
	validate_ifname "$NAME" || fail "invalid device name"
	[ "$NAME" != "$UPLINK" ] || fail "device name must differ from uplink"
	validate_vid "$SERVICE_VID" || fail "service VLAN must be 1-4094"
	validate_vid "$MCAST_VID" || fail "multicast VLAN must be 1-4094"
	[ "$SERVICE_VID" != "$MCAST_VID" ] ||
		fail "service and multicast VLAN must differ"
	[ -e "/sys/class/net/$UPLINK" ] || fail "uplink $UPLINK was not found"

	apply_device
}

apply
exit 0
