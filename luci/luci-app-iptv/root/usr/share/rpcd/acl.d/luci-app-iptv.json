{
	"luci-app-iptv": {
		"description": "Grant access to IPTV device configuration",
		"read": {
			"uci": [ "iptv", "network" ],
			"ubus": {
				"network.device": [ "status" ],
				"network.interface": [ "dump" ],
				"file": [ "list" ]
			},
			"file": {
				"/etc/config": [ "list" ]
			}
		},
		"write": {
			"uci": [ "iptv" ],
			"ubus": {
				"file": [ "write" ]
			},
			"file": {
				"/etc/config/iptv": [ "write" ]
			}
		}
	}
}
